# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://edinio.com
NEXT_PUBLIC_APP_URL=https://edinio.com

# Marketing — pixeli platforma (edinio.com insasi, NU magazinele clientilor)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Marketing — conversii de pe SERVER catre aceiasi doi furnizori.
#
# ⚠ FARA ELE NU CADE NIMIC, SI TOCMAI DE-AIA TREBUIE SCRISE AICI. `destinatiiActive()`
# intoarce lista goala, punerea la coada devine un nimic, si totul pare sanatos:
# build verde, probe verzi, zero erori — si zero conversii server-side. Singurul
# semn e o intrare in jurnal, `conversii.destinatieNelegata`, pe care nimeni n-o
# cauta daca nu stie ca exista.
#
# Se iau din Events Manager (Meta) si din Events API (TikTok). Sunt SECRETE:
# nu au prefixul NEXT_PUBLIC_ si nu au voie sa ajunga in browser.
META_CAPI_TOKEN=
TIKTOK_EVENTS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_ULTRA=price_...
# Preturi anuale (recurring an, = pret lunar × 9 → 3 luni gratuite). Creeaza in
# Stripe cate un Price cu billing period = yearly pentru fiecare plan.
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_ULTRA_ANNUAL=price_...

# ═══ MASURAREA EDINIO (site-ul NOSTRU de prezentare) ═══
#
# ⚠ NU SE CONFUNDA cu marketingul comerciantilor. Ei isi pun propriile coduri in
# configuratia fiecarui magazin (Setari > Marketing), din baza de date, nu de aici.
# Granita e probata in src/lib/granita-tracking.test.ts si n-are voie sa se stearga.
#
# ⚠ GOL = STINS. Fara cod, eticheta nu se randeaza deloc si nu pleaca nicio cerere.
# Asa raman probele si dezvoltarea curate fara nicio alta paza.
NEXT_PUBLIC_EDINIO_GA4_MEASUREMENT_ID=

# reCAPTCHA v3 — formularele publice (Contact, Migrare, Newsletter)
#
# ⚠ LIPSEAU DE AICI, si asta avea o urmare: CI face `cp .env.example .env.local`,
# deci ce dovedea el pana acum era ca site-ul se CONSTRUIESTE fara CAPTCHA, nu ca
# o configuratie de productie o contine. Verificarea din `recaptcha.ts` e scrisa
# dinadins sa treaca fara cheie (mai bine formularul merge decat sa refuze
# clienti adevarati cand cineva uita variabila) — deci nimic nu striga.
#
# ⚠ Lasate GOALE aici, nu completate: goale se poarta ca lipsa, adica exact ce
# vrem la probe. In Vercel Production trebuie sa aiba valori.
#
# Cele patru stari cu putinta, ca sa nu fie descoperite pe rand:
#   amandoua puse        verificare adevarata
#   doar cea publica     tokenul se cere, serverul nu-l verifica
#   doar cea secreta     browserul nu trimite token, serverul respinge tot
#   niciuna              formularele merg fara CAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@edinio.com
EMAIL_FROM=Edinio <noreply@edinio.com>
SUPPORT_ADMIN_EMAIL=support@edinio.com

# SmartBill (Facturare)
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=

# Upload Temp (secure random string)
UPLOAD_TEMP_SECRET=change-me-to-random-string

# Vercel Cron (auto-set by Vercel, or set manually for local testing)
CRON_SECRET=

# Cloudflare R2 (Image Storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=edinio-uploads
# Public base used when SAVING object URLs. Either the raw bucket domain
# (https://pub-XXXXX.r2.dev) or the CDN custom domain (https://edinio-cdn.com).
# Switching to the CDN domain is safe: old r2.dev URLs are still recognized.
R2_PUBLIC_URL=https://pub-XXXXX.r2.dev

# Optional CDN custom domain bound to the R2 bucket, with Cloudflare Image
# Transformations enabled. When set, images RENDER through the edge resizer
# (<cdn>/cdn-cgi/image/...) instead of the self-hosted /api/img optimizer.
# Existing *.r2.dev URLs are rewritten to this domain at render time (no migration).
NEXT_PUBLIC_CDN_URL=https://edinio-cdn.com

# Reseller.ro (Domenii)
RESELLER_EMAIL=
RESELLER_API_KEY=
RESELLER_NS1=ns1.domaincity.ro
RESELLER_NS2=ns2.domaincity.ro
