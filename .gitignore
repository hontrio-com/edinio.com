# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local secrets / credentials (do NOT match .env*)
*.r2env
.r2env
scripts/.r2env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# local scratch under scripts/ (product-import/scrape data, generated SQL,
# scraped images). Tot ce e aici e ignorat IN AFARA de ce se enumera mai jos,
# deci o unealta pusa in scripts/ si legata in package.json n-ar ajunge niciodata
# in depozit, si ar lipsi pentru toti ceilalti.
/scripts/*
!/scripts/migrations/
!/scripts/tests/
!/scripts/leaga-capturi.mjs
