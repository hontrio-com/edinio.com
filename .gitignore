# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local secrets / credentials (do NOT match .env*)
*.r2env
.r2env
scripts/.r2env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# local scratch under scripts/ (product-import/scrape data, generated SQL,
# scraped images) — only scripts/migrations/ is tracked
/scripts/*
!/scripts/migrations/
!/scripts/tests/
# Generatorul de baseline: NU e scratch, e unealta. CI-ul il ruleaza
# (`schema-baseline.sh --check`), iar fara el jobul de deriva n-are ce executa.
!/scripts/schema-baseline.sh
# ⚠ Fara randurile astea, jobul de CI care le ruleaza cade la FIECARE push:
# fisierele exista local, dar nu ajung niciodata in depozit.
!/scripts/verifica-tipuri-db.mjs
!/scripts/tipuri-db-prag.json
# Iesirea catre eMAG: NU e scratch, e infrastructura. eMAG accepta apeluri doar de la
# IP-uri albite, iar Vercel n-are IP fix — deci exista un server propriu, cu proxy
# CONNECT, iar dosarul asta e TOATA starea lui. Chiar de aia nu se plateste copie de
# siguranta la Contabo: serverul se reface de aici in zece minute. Netinut in depozit,
# afirmatia aia ar fi fost falsa.
!/scripts/emag-proxy/
